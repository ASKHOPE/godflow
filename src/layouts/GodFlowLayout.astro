---
import { ClientRouter } from "astro:transitions";
import "../styles/tokens.css";
import "../styles/layout.css";
import "../styles/components.css";

interface Props {
  title: string;
  route:
    | "command"
    | "subscriptions"
    | "suite"
    | "emulate"
    | "studio"
    | "calendar"
    | "pipeline"
    | "hub"
    | "distribution"
    | "affiliates"
    | "sponsors"
    | "finance"
    | "system"
    | "team"
    | "admin"
    | "newlifecorp"
    | "register";
}

const { title, route } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        function syncSchemeAndAuthMode() {
          try {
            var saved = localStorage.getItem("color-scheme");
            var meta = document.querySelector('meta[name="color-scheme"]');
            if (meta) {
              meta.content = saved === "light" || saved === "dark" ? saved : "light dark";
            }
            var raw = localStorage.getItem("godflow:state:v14");
            var parsed = raw ? JSON.parse(raw) : null;
            var authed = Boolean(parsed && parsed.session && parsed.session.authenticated);
            document.documentElement.dataset.godflowAuth = authed ? "app" : (parsed && parsed.session && parsed.session.authView === "login" ? "login" : "public");
          } catch (_) {
            document.documentElement.dataset.godflowAuth = "public";
          }
        }
        syncSchemeAndAuthMode();
        document.addEventListener("astro:after-swap", syncSchemeAndAuthMode);
      })();
    </script>
    <title>{title} | GodFlow OS</title>
    <meta
      name="description"
      content="GodFlow Multi-Tenant Creator-Media Operating System — Independent dual sidebars, 6 production scenarios, RBAC team roles, and God Mode administration."
    />
    <ClientRouter />
  </head>
  <body>
    <a href="#main-heading" class="skip-link visually-hidden">Skip to main content</a>

    <div id="login-gate-root" class="login-shell" hidden></div>
    <div id="public-site-root" class="public-site-root" hidden></div>

    <div id="app-shell" class="app-shell">
      <!-- Independent Left Navigation Rail -->
      <aside id="nav-rail" class="nav-rail" aria-label="Workspace navigation" transition:persist="nav-rail">
        <div class="rail-brand">
          <a href="/" class="brand-link" aria-label="GodFlow Home">
            <span class="brand-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L3 7v10l9 5 9-5V7l-9-5z" />
                <path d="M12 12l9-5M12 12v10M12 12L3 7" />
              </svg>
            </span>
            <span class="brand-text">
              <span class="brand-name">GodFlow</span>
              <span class="brand-tag" id="rail-workspace-tag">godflow.studio</span>
            </span>
          </a>
          <button
            type="button"
            id="rail-pin-btn"
            class="rail-pin-btn"
            aria-pressed="false"
            aria-label="Pin left navigation rail open"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 4v16M15 8l-4 4 4 4" />
            </svg>
          </button>
        </div>

        <nav aria-label="Primary" class="rail-nav">
          <div class="rail-group">
            <p class="rail-section-label" aria-hidden="true">SaaS &amp; Sandbox</p>
            <ul class="rail-list">
              <li>
                <a href="/subscriptions" class="rail-item" data-route="subscriptions" aria-current={route === "subscriptions" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                      <circle cx="8.5" cy="7" r="4" />
                      <path d="M20 8v6M23 11h-6" />
                    </svg>
                  </span>
                  <span class="rail-label">Manage Subscriptions</span>
                  <span class="rail-badge" id="badge-tenants-count">5</span>
                </a>
              </li>
              <li>
                <a href="/suite" class="rail-item" data-route="suite" aria-current={route === "suite" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M12 2l9 4.5-9 4.5L3 6.5 12 2z" />
                      <path d="M3 12l9 4.5 9-4.5" />
                      <path d="M3 17.5l9 4.5 9-4.5" />
                    </svg>
                  </span>
                  <span class="rail-label">Suite</span>
                  <span class="rail-badge rail-badge--god" id="badge-suite-track">3 VER</span>
                </a>
              </li>
              <li>
                <a href="/emulate" class="rail-item" data-route="emulate" aria-current={route === "emulate" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="3" y="4" width="18" height="14" rx="2" />
                      <path d="M8 20h8M12 18v2M8 10l2.5 2L8 14M13 14h3" />
                    </svg>
                  </span>
                  <span class="rail-label">Emulate</span>
                  <span class="rail-badge" id="badge-sandbox-state">PROD</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="rail-group">
            <p class="rail-section-label" aria-hidden="true">Studio Core</p>
            <ul class="rail-list">
              <li>
                <a href="/" class="rail-item" data-route="command" aria-current={route === "command" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="3" y="3" width="7" height="9" rx="1.5" />
                      <rect x="14" y="3" width="7" height="5" rx="1.5" />
                      <rect x="14" y="12" width="7" height="9" rx="1.5" />
                      <rect x="3" y="16" width="7" height="5" rx="1.5" />
                    </svg>
                  </span>
                  <span class="rail-label" id="rail-home-label">Command Center</span>
                </a>
              </li>
              <li>
                <a href="/studio" class="rail-item" data-route="studio" data-studio-all="true" aria-current={route === "studio" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="3" y="4" width="7" height="7" rx="1.5" />
                      <rect x="14" y="4" width="7" height="7" rx="1.5" />
                      <rect x="3" y="14" width="7" height="7" rx="1.5" />
                      <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    </svg>
                  </span>
                  <span class="rail-label">All Workbenches</span>
                </a>
              </li>
              <li>
                <a href="/studio?scenario=article" class="rail-item" data-route="studio" data-studio-scenario="article">
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M12 20h9" />
                      <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                    </svg>
                  </span>
                  <span class="rail-label">Article Editor &amp; Sources</span>
                </a>
              </li>
              <li>
                <a href="/studio?scenario=video" class="rail-item" data-route="studio" data-studio-scenario="video">
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="2" y="5" width="14" height="14" rx="2" />
                      <path d="M16 10l6-3v10l-6-3z" />
                    </svg>
                  </span>
                  <span class="rail-label">Videos &amp; Shorts Studio</span>
                </a>
              </li>
              <li>
                <a href="/studio?scenario=podcast" class="rail-item" data-route="studio" data-studio-scenario="podcast">
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="9" y="3" width="6" height="11" rx="3" />
                      <path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8" />
                    </svg>
                  </span>
                  <span class="rail-label">Podcast Script &amp; Live</span>
                </a>
              </li>
              <li>
                <a href="/studio?scenario=stock" class="rail-item" data-route="studio" data-studio-scenario="stock">
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <polyline points="3 17 9 11 13 15 21 7" />
                      <circle cx="21" cy="7" r="2" />
                    </svg>
                  </span>
                  <span class="rail-label">Live Stream Desk</span>
                </a>
              </li>
              <li>
                <a href="/studio?scenario=music" class="rail-item" data-route="studio" data-studio-scenario="music">
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M9 18V5l11-2v13" />
                      <circle cx="6.5" cy="18" r="2.5" />
                      <circle cx="17.5" cy="16" r="2.5" />
                    </svg>
                  </span>
                  <span class="rail-label">Music &amp; Lyrics Studio</span>
                </a>
              </li>
              <li>
                <a href="/studio?scenario=social" class="rail-item" data-route="studio" data-studio-scenario="social">
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="3" y="4" width="18" height="16" rx="2.5" />
                      <circle cx="8.5" cy="9.5" r="1.5" />
                      <path d="M4 17l5-4 4 3 4-4 4 5" />
                    </svg>
                  </span>
                  <span class="rail-label">Thumbnails, GIFs &amp; Social</span>
                </a>
              </li>
              <li>
                <a href="/calendar" class="rail-item" data-route="calendar" aria-current={route === "calendar" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="3" y="4" width="18" height="18" rx="2" />
                      <path d="M16 2v4M8 2v4M3 10h18" />
                      <path d="M8 14h3M13 14h3M8 18h3" />
                    </svg>
                  </span>
                  <span class="rail-label">Mega Calendar</span>
                  <span class="rail-badge rail-badge--god" id="badge-active-watchers">7 LIVE</span>
                </a>
              </li>
              <li>
                <a href="/pipeline" class="rail-item" data-route="pipeline" aria-current={route === "pipeline" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="3" y="4" width="5" height="16" rx="1" />
                      <rect x="10" y="4" width="5" height="11" rx="1" />
                      <rect x="17" y="4" width="4" height="14" rx="1" />
                    </svg>
                  </span>
                  <span class="rail-label">Production Pipeline</span>
                  <span class="rail-badge" id="badge-pipeline">8</span>
                </a>
              </li>
              <li>
                <a href="/hub" class="rail-item" data-route="hub" aria-current={route === "hub" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                      <path d="M9 7h7M9 11h5" />
                    </svg>
                  </span>
                  <span class="rail-label">Content Hub &amp; Organizer</span>
                </a>
              </li>
              <li>
                <a href="/distribution" class="rail-item" data-route="distribution" aria-current={route === "distribution" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M22 2L11 13" />
                      <path d="M22 2l-7 20-4-9-9-4 20-7z" />
                    </svg>
                  </span>
                  <span class="rail-label">Distribution</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="rail-group">
            <p class="rail-section-label" aria-hidden="true">Monetization</p>
            <ul class="rail-list">
              <li>
                <a href="/affiliates" class="rail-item" data-route="affiliates" aria-current={route === "affiliates" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </svg>
                  </span>
                  <span class="rail-label">Affiliates &amp; /go</span>
                </a>
              </li>
              <li>
                <a href="/sponsors" class="rail-item" data-route="sponsors" aria-current={route === "sponsors" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                      <circle cx="9" cy="7" r="4" />
                      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                  </span>
                  <span class="rail-label">Sponsors &amp; Collabs</span>
                </a>
              </li>
              <li>
                <a href="/finance" class="rail-item" data-route="finance" aria-current={route === "finance" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="2" y="5" width="20" height="14" rx="2" />
                      <path d="M2 10h20" />
                      <path d="M6 15h4" />
                    </svg>
                  </span>
                  <span class="rail-label">Finance &amp; Ledger</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="rail-group">
            <p class="rail-section-label" aria-hidden="true">Tenancy &amp; Admin</p>
            <ul class="rail-list">
              <li>
                <a href="/team" class="rail-item" data-route="team" aria-current={route === "team" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                  </span>
                  <span class="rail-label">Team &amp; Roles</span>
                  <span class="rail-badge" id="badge-team-count">10</span>
                </a>
              </li>
              <li>
                <a href="/admin" class="rail-item" data-route="admin" aria-current={route === "admin" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                  </span>
                  <span class="rail-label">God Mode &amp; Admin</span>
                  <span class="rail-badge rail-badge--god" id="badge-god-state">MASTER</span>
                </a>
              </li>
              <li>
                <a href="/newlifecorp" class="rail-item" data-route="newlifecorp" aria-current={route === "newlifecorp" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <circle cx="12" cy="12" r="9" />
                      <path d="M3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
                    </svg>
                  </span>
                  <span class="rail-label">NewLifeCorp SaaS</span>
                </a>
              </li>
              <li>
                <a href="/system" class="rail-item" data-route="system" aria-current={route === "system" ? "page" : undefined}>
                  <span class="rail-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                      <rect x="2" y="3" width="20" height="8" rx="2" />
                      <rect x="2" y="13" width="20" height="8" rx="2" />
                      <path d="M6 7h.01M6 17h.01M10 7h8M10 17h8" />
                    </svg>
                  </span>
                  <span class="rail-label">System Health</span>
                  <span class="rail-badge rail-badge--warn" id="badge-failed-jobs">3</span>
                </a>
              </li>
            </ul>
          </div>
        </nav>

        <div class="rail-footer">
          <button type="button" id="rail-session-btn" class="creator-pill" aria-label="Open workspace, user, and role switcher">
            <span class="creator-avatar" id="rail-user-avatar" aria-hidden="true">AM</span>
            <span class="creator-meta">
              <span class="creator-name" id="rail-user-name">Alex Mercer</span>
              <span class="creator-stack" id="rail-user-role">GOD MODE · alex-mercer</span>
            </span>
          </button>
        </div>
      </aside>

      <!-- Independent Right Context Sidebar -->
      <aside id="right-rail" class="right-rail" aria-label="Context, roles, and scenario sidebar" transition:persist="right-rail">
        <div class="right-rail-head">
          <div class="right-rail-title-wrap">
            <span class="mono-meta" style="font-weight:700;color:var(--text-primary);">GODFLOW CONTEXT</span>
          </div>
          <div class="right-rail-actions">
            <button
              type="button"
              id="right-pin-btn"
              class="rail-pin-btn"
              aria-pressed="false"
              aria-label="Pin right context sidebar open"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 4v16M9 8l4 4-4 4" />
              </svg>
            </button>
            <button
              type="button"
              id="right-hide-btn"
              class="rail-pin-btn"
              aria-label="Collapse right context sidebar"
            >
              ✕
            </button>
          </div>
        </div>

        <div class="right-rail-collapsed-strip" aria-hidden="false">
          <button type="button" class="icon-btn" data-right-quicktab="session" aria-label="Open Session, Workspace and Role Switcher">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9">
              <circle cx="12" cy="8" r="4" />
              <path d="M4 20c1.5-4 14.5-4 16 0" />
            </svg>
          </button>
          <button type="button" class="icon-btn" data-right-quicktab="flows" aria-label="Open Scenarios Live Drawer">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9">
              <path d="M3 6h18M3 12h12M3 18h18" />
            </svg>
          </button>
          <button type="button" class="icon-btn" data-right-quicktab="audit" aria-label="Open Multi-Tenant Audit Stream">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9">
              <path d="M12 8v4l3 3" />
              <circle cx="12" cy="12" r="9" />
            </svg>
          </button>
        </div>

        <div id="right-rail-body" class="right-rail-body"></div>
      </aside>

      <div class="workspace-frame">
        <header class="topbar">
          <div class="topbar-start">
            <button
              type="button"
              id="mobile-menu-btn"
              class="icon-btn mobile-only"
              aria-expanded="false"
              aria-controls="nav-rail"
              aria-label="Open left navigation menu"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
            <div class="breadcrumb" aria-label="Current workspace section">
              <span class="breadcrumb-root" id="topbar-tenant-domain">godflow.studio</span>
              <span class="breadcrumb-sep" aria-hidden="true">/</span>
              <span id="topbar-module-name" class="breadcrumb-current">{title}</span>
            </div>
            <span class="status-pill status-pill--ok" id="topbar-infra-pill">
              <span class="status-dot" aria-hidden="true"></span>
              <span>ETAPI + BullMQ Live</span>
            </span>
          </div>

          <div class="topbar-end" id="topbar-session-controls">
            <label class="switcher-chip desktop-only">
              <span class="mono-meta">WS</span>
              <select id="top-ws-select" class="switcher-select" aria-label="Quick switch tenant workspace"></select>
            </label>
            <label class="switcher-chip desktop-only">
              <span class="mono-meta">CH</span>
              <select id="top-channel-select" class="switcher-select" aria-label="Quick switch channel"></select>
            </label>
            <label class="switcher-chip desktop-only">
              <span class="mono-meta">USER</span>
              <select id="top-user-select" class="switcher-select" aria-label="Quick switch active user"></select>
            </label>
            <label class="switcher-chip desktop-only">
              <span class="mono-meta">ROLE</span>
              <select id="top-role-select" class="switcher-select" aria-label="Quick switch RBAC role"></select>
            </label>
            <button
              type="button"
              id="top-login-btn"
              class="btn btn--subtle btn--sm"
              aria-label="Open sign in"
            >
              Sign In
            </button>
            <span id="top-profile-pill" class="badge mono" style="display:none;align-items:center;gap:0.35rem;"></span>
            <button
              type="button"
              id="top-logout-btn"
              class="btn btn--subtle btn--sm"
              style="display:none;"
              aria-label="Logout"
            >
              Logout
            </button>
            <button
              type="button"
              id="topbar-right-toggle"
              class="icon-btn"
              aria-pressed="false"
              aria-controls="right-rail"
              aria-label="Toggle right context sidebar"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <path d="M15 3v18" />
              </svg>
            </button>
            <button
              type="button"
              id="theme-toggle-btn"
              class="icon-btn theme-toggle"
              aria-label="Toggle color scheme"
            >
              <span class="theme-icon-dark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9">
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                </svg>
              </span>
              <span class="theme-icon-light" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                </svg>
              </span>
              <span class="visually-hidden theme-toggle-text">Switch theme</span>
            </button>
          </div>
        </header>

        <div id="god-banner" class="god-banner" hidden></div>
        <div id="waterfall-breadcrumb" class="wf-breadcrumb-bar" hidden></div>

        <main id="workspace-main" class="workspace-main" data-route={route} tabindex="-1">
          <slot />
        </main>
      </div>
    </div>

    <!-- Slide-over Detail Drawer (Native Modal Dialog) -->
    <dialog id="pipeline-drawer" class="drawer" closedby="any" aria-labelledby="drawer-title" transition:persist="drawer">
      <div id="drawer-content" class="drawer-inner"></div>
    </dialog>

    <!-- Primary Modal Dialog -->
    <dialog id="app-modal" class="modal" closedby="any" aria-labelledby="modal-title" transition:persist="modal">
      <div id="modal-content" class="modal-inner"></div>
    </dialog>

    <!-- Toast Stack & Polite Live Region -->
    <div id="toast-region" class="toast-region" role="region" aria-label="Notifications" transition:persist="toasts"></div>
    <p class="visually-hidden">Screen reader announcements</p>
    <div id="sr-announcer" class="visually-hidden" aria-live="polite" aria-atomic="true" transition:persist="announcer"></div>

    <script>
      import "../main.js";
    </script>
  </body>
</html>
